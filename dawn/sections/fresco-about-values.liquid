<section class="about-values">
  <div class="container">
    <div class="header">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="products__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>
    <div class="values-slider">
      <div class="swiper about-values-swiper" data-section-id="{{ section.id }}">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- if block.type == 'value_card' -%}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <article
                  class="value-card"
                  {% if block.settings.background_image != blank %}
                    style="--value-card-image: url('{{ block.settings.background_image | image_url: width: 1200 }}');"
                  {% endif %}
                >
                  {%- if block.settings.icon != blank -%}
                    <div class="value-card__icon">
                      <i class="{{ block.settings.icon }}"></i>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.heading != blank -%}
                    <h3>{{ block.settings.heading }}</h3>
                  {%- endif -%}
                  {%- if block.settings.content != blank -%}
                    <div class="rte">{{ block.settings.content }}</div>
                  {%- endif -%}
                </article>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="about-values__nav" data-section-id="{{ section.id }}">
        <button
          class="about-values__arrow about-values__arrow--prev"
          aria-label="Previous advantage"
          data-section-id="{{ section.id }}"
        >
          <i class="fa-solid fa-arrow-left"></i>
        </button>
        <div class="about-values__pagination" data-section-id="{{ section.id }}"></div>
        <button
          class="about-values__arrow about-values__arrow--next"
          aria-label="Next advantage"
          data-section-id="{{ section.id }}"
        >
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fresco About Values",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Values Section Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Competitive Edge"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Our competitive advantage lies in our ability to provide high-quality, consistent products that are free from additives and preservatives."
    }
  ],
  "blocks": [
    {
      "type": "value_card",
      "name": "Value Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon Class",
          "info": "Font Awesome icon class (e.g., fa-solid fa-sitemap)",
          "default": "fa-solid fa-sitemap"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Vertical Integration"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>We operate a fully integrated value chain where cultivation, processing and packaging are under one roof. With the elimination of intermediaries, we assure premium quality and full traceability—delivering superior quality at a competitive price.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresco About Values",
      "blocks": [
        {
          "type": "value_card",
          "settings": {
            "icon": "fa-solid fa-sitemap",
            "heading": "Vertical Integration",
            "content": "<p>We operate a fully integrated value chain where cultivation, processing and packaging are under one roof. With the elimination of intermediaries, we assure premium quality and full traceability—delivering superior quality at a competitive price.</p>"
          }
        },
        {
          "type": "value_card",
          "settings": {
            "icon": "fa-solid fa-location-dot",
            "heading": "Strategic Location",
            "content": "<p>Fresco Flavors—powered by Freezedry Harvest EPZ in Kenya, benefits from year round conducive climate conditions that allow for robust cultivation eliminating seasonal gaps, making our products available on demand. With the EPZ advantages, we offer flexible bulk orders, export ready.</p>"
          }
        },
        {
          "type": "value_card",
          "settings": {
            "icon": "fa-solid fa-certificate",
            "heading": "Certifications",
            "content": "<p>Our freeze-drying facility holds the USDA Organic certification, backed with the FSSC 22000 and OU Kosher certifications. This stems from our unwavering commitment to climate and environment protection, conservation of soil fertility, our general respect of natural cycles and transparent labeling for our consumers.</p>"
          }
        },
        {
          "type": "value_card",
          "settings": {
            "icon": "fa-solid fa-earth-africa",
            "heading": "Social & Environmental Impact",
            "content": "<p>Since its inception, Fresco Flavors and Freezedry Harvest EPZ Kenya, has created meaningful employment from our massive organic farms and in-factory operations to the local community in Kenya.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
