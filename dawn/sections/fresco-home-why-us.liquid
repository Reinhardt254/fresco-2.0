{%- style -%}
  .why-us {
    padding: 5rem 0;
    background: var(--background-secondary);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .why-us .container {
    width: 90%;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .why-us__intro {
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .why-us__text {
    flex: 1 1 420px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .why-us__badge {
    flex: 0 0 240px;
    background: var(--primary);
    color: #fff;
    border-radius: 24px;
    padding: 2.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .why-us__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .why-us__card {
    background: #fff;
    border-radius: 18px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .why-us__icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(4, 93, 66, 0.08);
    color: var(--primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
  }

  .why-us__cta {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    align-items: center;
  }

  @media (max-width: 1024px) {
    .why-us__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .why-us__grid {
      grid-template-columns: 1fr;
    }

    .why-us__badge {
      width: 100%;
    }
  }

  @media (max-width: 600px) {
    .why-us {
      padding: 2rem 0;
    }

    .why-us__badge {
      flex: 1 1 100%;
      height: auto;
      aspect-ratio: 1/1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
    }
  }
{%- endstyle -%}

<section class="why-us">
  <div class="container">
    <div class="why-us__intro">
      <div class="why-us__text">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p>{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.show_badge -%}
        <div class="why-us__badge">
          {%- if section.settings.badge_text_top != blank -%}
            <small>{{ section.settings.badge_text_top }}</small>
          {%- endif -%}
          {%- if section.settings.badge_text_main != blank -%}
            <span>{{ section.settings.badge_text_main }}</span>
          {%- endif -%}
          {%- if section.settings.badge_text_bottom != blank -%}
            <small>{{ section.settings.badge_text_bottom }}</small>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="why-us__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit_card' -%}
          <article class="why-us__card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="why-us__icon">
                <i class="{{ block.settings.icon }}"></i>
              </div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h4>{{ block.settings.title }}</h4>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p>{{ block.settings.description }}</p>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_cta and section.settings.cta_text != blank and section.settings.cta_link != blank -%}
      <div class="why-us__cta">
        <a href="{{ section.settings.cta_link }}" class="cta cta--solid">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Fresco Home Why Us",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Why Us Section Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why chefs and foodservice partners choose Fresco Flavors"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Fresco Flavors delivers the essence of fresh herbs—preserved at peak flavor and color—in a format that saves chefs time, reduces waste, and guarantees consistency year-round. Our herbs are 100% natural, single-ingredient, and freeze-dried at source to capture nature's best in every flake."
    },
    {
      "type": "header",
      "content": "Badge Settings"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text_top",
      "label": "Badge Text Top",
      "default": "Cook Like"
    },
    {
      "type": "text",
      "id": "badge_text_main",
      "label": "Badge Text Main",
      "default": "CARMY"
    },
    {
      "type": "text",
      "id": "badge_text_bottom",
      "label": "Badge Text Bottom",
      "default": "In No Time"
    },
    {
      "type": "header",
      "content": "CTA Settings"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show CTA Button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Feature Our Product"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ],
  "blocks": [
    {
      "type": "benefit_card",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon Class",
          "info": "Font Awesome icon class (e.g., fa-solid fa-leaf)",
          "default": "fa-solid fa-leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Zero waste, longer shelf life"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Fresh herbs spoil in days; ours last up to 24 months while holding their full aroma, color, and brightness."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresco Home Why Us",
      "blocks": [
        {
          "type": "benefit_card",
          "settings": {
            "icon": "fa-solid fa-leaf",
            "title": "Zero waste, longer shelf life",
            "description": "Fresh herbs spoil in days; ours last up to 24 months while holding their full aroma, color, and brightness."
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "icon": "fa-solid fa-scissors",
            "title": "Labor-saving",
            "description": "Skip washing, trimming, and chopping—just measure, sprinkle, and serve. Every flake is service-ready."
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "icon": "fa-solid fa-truck-fast",
            "title": "Consistent supply",
            "description": "No seasonal gaps, no inconsistent quality, and no dependency on fragile cold-chain logistics."
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "icon": "fa-solid fa-seedling",
            "title": "Sustainable & Sourcing",
            "description": "Responsibly grown and processed at origin, supporting local communities and reducing environmental impact."
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "icon": "fa-solid fa-fire-flame-curved",
            "title": "Full flavor",
            "description": "Freeze-drying locks in essential oils and aroma to deliver near-fresh intensity in hot or cold dishes."
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "icon": "fa-solid fa-chart-line",
            "title": "Cost efficient",
            "description": "Lower spoilage, reduced storage needs, and predictable pricing help kitchens protect their margins."
          }
        }
      ]
    }
  ]
}
{% endschema %}
