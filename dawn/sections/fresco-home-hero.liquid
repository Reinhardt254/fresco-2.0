{%- style -%}
  .hero {
    min-height: 100%;
    height: 100%;
    position: relative;
    color: #fff;
    overflow: hidden;
  }

  .hero-swiper[data-autoplay-delay] {
    --autoplay-delay: {{ section.settings.autoplay_delay }}ms;
  }
{%- endstyle -%}

<section class="hero">
  <div class="swiper hero-swiper" data-autoplay-delay="{{ section.settings.autoplay_delay }}">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          <div
            class="swiper-slide hero__slide"
            {{ block.shopify_attributes }}
            style="--hero-bg: url('{{ block.settings.background_image | image_url: width: 1920 }}');"
          >
            <div class="hero__content">
              {%- if block.settings.eyebrow != blank -%}
                <p class="eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h1>{{ block.settings.heading }}</h1>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="description">{{ block.settings.description }}</p>
              {%- endif -%}
              {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                <a href="{{ block.settings.button_link }}" class="cta">{{ block.settings.button_text }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="hero__controls">
      <button
        class="hero__control hero__control--prev"
        aria-label="Previous slide"
      >
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button
        class="hero__control hero__control--next"
        aria-label="Next slide"
      >
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
    <div class="hero__pagination"></div>
  </div>
</section>

{% schema %}
{
  "name": "Fresco Home Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero Settings"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 3000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "label": "Autoplay Delay",
      "default": 7000
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Text",
          "info": "Optional small text above the heading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "FARM-TO-TABLE FLAVOR, READY TO USE"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Harvested in Kenya at peak freshness, freeze-dried at source, and packed for chefs who need flavor, consistency, and zero waste— year-round."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link",
          "default": "/collections/all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresco Home Hero",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "FARM-TO-TABLE FLAVOR, READY TO USE",
            "description": "Harvested in Kenya at peak freshness, freeze-dried at source, and packed for chefs who need flavor, consistency, and zero waste— year-round.",
            "button_text": "SHOP NOW",
            "button_link": "/collections/all"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "ORGANIC, Premium, AND NATURAL",
            "description": "Our crops are hand-picked at peak ripeness, capturing nature's fullest flavor, highest nutritional value, and aroma in every harvest.",
            "button_text": "SHOP NOW",
            "button_link": "/collections/all"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "Everyday cooking made better.",
            "description": "In our jars, lies the promise of ready-to-use freeze-dried herbs —bold and vibrant in taste, beyond fresh.",
            "button_text": "Shop Now",
            "button_link": "/collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
