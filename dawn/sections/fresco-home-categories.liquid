<section class="categories">
  <div class="container">
    {%- for block in section.blocks -%}
      {%- if block.type == 'category_card' -%}
        <article class="category-card" {{ block.shopify_attributes }}>
          {%- if block.settings.category_image != blank -%}
            <div class="category-card__image" aria-hidden="true">
              <img
                src="{{ block.settings.category_image | image_url: width: 800 }}"
                alt="{{ block.settings.category_image.alt | default: block.settings.title | escape }}"
                loading="lazy"
                width="800"
                height="auto"
              >
            </div>
          {%- endif -%}
          {%- if block.settings.title != blank and block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="category-card__cta">
              <span>{{ block.settings.title }}</span>
              <i class="fa-solid fa-arrow-right"></i>
            </a>
          {%- endif -%}
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Fresco Home Categories",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "category_image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Freeze-Dried Herbs"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresco Home Categories",
      "blocks": [
        {
          "type": "category_card",
          "settings": {
            "title": "Freeze-Dried Herbs",
            "link": "/collections/all"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Specialty Ingredients",
            "link": "/collections/all"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Bulk Formats",
            "link": "/collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}

