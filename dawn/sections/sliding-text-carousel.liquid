{%- style -%}
  .sliding-text {
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 10;
    background: var(--primary);
    color: #ffffff;
    padding: 0.5rem 0;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    font-size: 1.2rem;
  }
{%- endstyle -%}

{%- if section.settings.enable_sliding_text -%}
  <section class="sliding-text">
    <div class="sliding-text-swiper swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- if block.type == 'text_item' -%}
            <div class="swiper-slide">
              <p>{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Sliding Text Carousel",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sliding_text",
      "label": "Enable Sliding Text",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "text_item",
      "name": "Text Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Fresco Flavors"
        }
      ]
    }
  ],
