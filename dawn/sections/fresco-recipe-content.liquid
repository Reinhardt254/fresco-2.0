{{ 'fresco/recipe-styles.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="recipe-content section-{{ section.id }}-padding">
  <div class="container recipe-layout">
    <!-- Ingredients Sidebar -->
    <aside class="recipe-sidebar">
      <h2>{{ section.settings.ingredients_heading | default: 'Ingredients' }}</h2>
      {%- if section.blocks.size > 0 -%}
        <ul class="ingredients-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'ingredient' -%}
              <li {{ block.shopify_attributes }}>
                {%- if block.settings.amount != blank -%}
                  <span class="ingredient-amount">{{ block.settings.amount }}</span>
                {%- endif -%}
                {%- if block.settings.name != blank -%}
                  <span class="ingredient-name">{{ block.settings.name }}</span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        {%- comment -%} Parse ingredients from article content if no blocks {%- endcomment -%}
        <ul class="ingredients-list">
          <li>
            <span class="ingredient-amount">-</span>
            <span class="ingredient-name">Add ingredients using section blocks</span>
          </li>
        </ul>
      {%- endif -%}
    </aside>

    <!-- Instructions -->
    <div class="recipe-instructions">
      {% comment %} <h2>{{ section.settings.instructions_heading | default: 'Instructions' }}</h2> {% endcomment %}

      {%- if article.content != blank -%}
        <div class="rte">
          {{ article.content }}
        </div>
      {%- else -%}
        {%- if section.blocks.size > 0 -%}
          <ol class="instructions-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'instruction' -%}
                <li {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h3>{{ block.settings.heading }}</h3>
                  {%- endif -%}
                  {%- if block.settings.content != blank -%}
                    <p>{{ block.settings.content }}</p>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        {%- endif -%}
      {%- endif -%}

      <!-- Tips Section -->
      {%- if section.blocks.size > 0 -%}
        {%- assign has_tips = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'tip' -%}
            {%- assign has_tips = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_tips -%}
          <div class="recipe-tips">
            <h2>{{ section.settings.tips_heading | default: "Chef's Tips" }}</h2>
            <ul class="tips-list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'tip' -%}
                  <li {{ block.shopify_attributes }}>
                    {%- if block.settings.content != blank -%}
                      <p>{{ block.settings.content }}</p>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fresco Recipe Content",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "ingredients_heading",
      "label": "Ingredients Heading",
      "default": "Ingredients"
    },
    {
      "type": "text",
      "id": "instructions_heading",
      "label": "Instructions Heading",
      "default": "Instructions"
    },
    {
      "type": "text",
      "id": "tips_heading",
      "label": "Tips Heading",
      "default": "Chef's Tips"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "amount",
          "label": "Amount",
          "default": "2 tbsp",
          "info": "e.g., 2 tbsp, 1 cup, 4 large"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Ingredient Name",
          "default": "butter"
        }
      ]
    },
    {
      "type": "instruction",
      "name": "Instruction Step",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Step Heading",
          "default": "Step 1"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Step Content",
          "default": "Describe the step in detail..."
        }
      ]
    },
    {
      "type": "tip",
      "name": "Tip",
      "settings": [
        {
          "type": "textarea",
          "id": "content",
          "label": "Tip Content",
          "default": "Share a helpful tip..."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresco Recipe Content",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "amount": "4",
            "name": "large eggs"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "amount": "2 tbsp",
            "name": "butter, divided"
          }
        },
        {
          "type": "instruction",
          "settings": {
            "heading": "Crack and prepare eggs",
            "content": "Crack the eggs into a medium bowl. Add the cream or milk, salt, and pepper. Whisk gently until just combined."
          }
        },
        {
          "type": "tip",
          "settings": {
            "content": "Low and slow is the key—cooking over medium-low heat ensures creamy, not rubbery, eggs."
          }
        }
      ]
    }
  ]
}
{% endschema %}
