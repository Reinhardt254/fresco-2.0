{{ 'fresco/product-styles.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<main class="product-main section-{{ section.id }}-padding">
  <div class="container product-layout">
    <section class="product-gallery">
      <div class="product-gallery__main">
        {%- if product.featured_image != blank -%}
          <img
            id="product-main-image"
            src="{{ product.featured_image | image_url: width: 1200 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            width="1200"
            height="auto"
            loading="eager"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'product-gallery__main-image' }}
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="product-gallery__thumbnails swiper">
          <div class="swiper-wrapper">
            {%- for image in product.images -%}
              <div class="swiper-slide">
                <button
                  class="thumb{% if forloop.first %} thumb--active{% endif %}"
                  data-image="{{ image | image_url: width: 1200 }}"
                  data-alt="{{ image.alt | default: product.title | escape }}"
                  type="button"
                  aria-label="View image {{ forloop.index }}"
                >
                  <img
                    src="{{ image | image_url: width: 200 }}"
                    alt="{{ image.alt | default: product.title | escape }}"
                    width="200"
                    height="200"
                    loading="lazy"
                  >
                </button>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </section>

    <section class="product-details">
      {%- if product.vendor != blank -%}
        <p class="product-category">{{ product.vendor }}</p>
      {%- endif -%}

      <h1>{{ product.title }}</h1>

      {%- if product.description != blank -%}
        <p class="product-subtitle">{{ product.description | strip_html | truncatewords: 30 }}</p>
      {%- endif -%}

      {%- unless product.has_only_default_variant -%}
        <div class="jar-selection">
          <label class="jar-selection-label">Select Variant</label>
          <div class="jar-buttons">
            {%- for option in product.options_with_values -%}
              {%- if option.name == 'Size' or option.name == 'Jar Size' -%}
                {%- for value in option.values -%}
                  <button
                    class="jar-button{% if forloop.first %} active{% endif %}"
                    data-variant-option="{{ option.position }}"
                    data-value="{{ value | escape }}"
                    type="button"
                  >
                    {{ value }}
                  </button>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endunless -%}

      <div class="product-pricing">
        <p class="product-price" id="product-price-{{ section.id }}">
          <span class="price-amount">{{ product.selected_or_first_available_variant.price | money }}</span>
          <span>each</span>
        </p>
        <p
          class="product-price-note"
          id="product-compare-price-{{ section.id }}"
          {% unless product.selected_or_first_available_variant.compare_at_price
              > product.selected_or_first_available_variant.price
          %}
            style="display: none;"
          {% endunless %}
        >
          Was
          <span class="compare-price-amount">
            {{- product.selected_or_first_available_variant.compare_at_price | money -}}
          </span>
        </p>
        <p class="product-stock" id="product-stock-{{ section.id }}">
          {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
            {{ product.selected_or_first_available_variant.inventory_quantity }} items in stock
          {%- elsif product.selected_or_first_available_variant.available == false -%}
            <span style="color: #d32f2f;">Out of stock</span>
          {%- else -%}
            In stock
          {%- endif -%}
        </p>
      </div>

      {%- liquid
        assign fallback_contact_url = pages.contact.url
        if fallback_contact_url == blank
          assign fallback_contact_url = routes.root_url | append: 'pages/contact'
        endif

        assign buy_now_url = section.settings.buy_now_url | default: fallback_contact_url
      -%}

      <input
        type="hidden"
        id="product-variant-id"
        value="{{ product.selected_or_first_available_variant.id }}"
      >

      <div class="product-actions" id="product-actions-{{ section.id }}">
        <div class="product-qty">
          <button type="button" aria-label="Decrease quantity" class="qty-decrease">-</button>
          <input
            type="number"
            id="quantity-{{ section.id }}"
            value="1"
            min="1"
            aria-label="Quantity"
          >
          <button type="button" aria-label="Increase quantity" class="qty-increase">+</button>
        </div>

        {%- if product.available -%}
          <a class="product-add" href="{{ buy_now_url }}">{{ section.settings.buy_now_label | escape }}</a>
        {%- else -%}
          <button type="button" class="product-add" disabled>Sold out</button>
        {%- endif -%}

        <button type="button" class="product-save" aria-label="Save product">
          <i class="fa-regular fa-heart"></i>
          Save
        </button>
      </div>

      {% comment %}
        Original Add to cart (kept for easy retrieval)
        <form
          action="{{ routes.cart_add_url }}"
          method="post"
          enctype="multipart/form-data"
          id="product-form-{{ section.id }}"
        >
          <input
            type="hidden"
            name="id"
            id="product-variant-id"
            value="{{ product.selected_or_first_available_variant.id }}"
          >

          <div class="product-actions">
            <div class="product-qty">
              <button type="button" aria-label="Decrease quantity" class="qty-decrease">-</button>
              <input
                type="number"
                name="quantity"
                id="quantity-{{ section.id }}"
                value="1"
                min="1"
                aria-label="Quantity"
              >
              <button type="button" aria-label="Increase quantity" class="qty-increase">+</button>
            </div>
            <button
              type="submit"
              name="add"
              class="product-add"
              {% unless product.available %}
                disabled
              {% endunless %}
            >
              Add to cart
            </button>
            <button type="button" class="product-save" aria-label="Save product">
              <i class="fa-regular fa-heart"></i>
              Save
            </button>
          </div>
        </form>
      {% endcomment %}

      {%- if section.blocks.size > 0 -%}
        <ul class="product-meta">
          {%- for block in section.blocks -%}
            {%- if block.type == 'meta_item' -%}
              <li {{ block.shopify_attributes }}>
                <span>{{ block.settings.label }}</span>
                <p>{{ block.settings.value }}</p>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </section>
  </div>

  {%- if product.description != blank -%}
    <section class="product-copy">
      <div class="product-description">
        <h2>Description</h2>
        <div class="rte">
          {{ product.description }}
        </div>
      </div>
    </section>
  {%- endif -%}
</main>

<script type="application/json" id="product-variants-{{ section.id }}">
  {
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "price": {{ variant.price }},
          "compare_at_price": {{ variant.compare_at_price | default: 0 }},
          "available": {{ variant.available | json }},
          "inventory_quantity": {{ variant.inventory_quantity | default: 0 }},
          "option1": {{ variant.option1 | json }},
          "option2": {{ variant.option2 | json }},
          "option3": {{ variant.option3 | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "money_format": {{ shop.money_format | json }}
  }
</script>

<script src="{{ 'fresco/fresco--product-gallery.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Fresco Product Main",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "url",
      "id": "buy_now_url",
      "label": "Buy now link",
      "info": "Where the Buy now button should go (e.g., your Contact page)."
    },
    {
      "type": "text",
      "id": "buy_now_label",
      "label": "Buy now button label",
      "default": "Buy now"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "meta_item",
      "name": "Meta Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Origin"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Naivasha, Kenya"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresco Product Main",
      "blocks": [
        {
          "type": "meta_item",
          "settings": {
            "label": "Origin",
            "value": "Naivasha, Kenya"
          }
        },
        {
          "type": "meta_item",
          "settings": {
            "label": "Flavor profile",
            "value": "Sweet anise, clove spice, and a peppery finish"
          }
        },
        {
          "type": "meta_item",
          "settings": {
            "label": "Best for",
            "value": "Pesto, tomato sauces, fresh herb oils, mozzarella salads"
          }
        }
      ]
    }
  ]
}
{% endschema %}
