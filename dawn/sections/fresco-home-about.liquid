{%- style -%}
  .about {
    padding: 4rem 0;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    gap: 2rem;
  }

  .about .container {
    width: 90%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 2rem;
  }

  @media screen and (max-width: 1024px) {
    .about .container {
      flex-direction: column;
      gap: 2rem;
      align-items: center;
      text-align: center;
      padding: 0 1rem;
    }
  }
{%- endstyle -%}

<section class="about">
  <div class="container">
    <div class="about__lead">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="cta cta--solid">{{ section.settings.button_text }}</a>
      {%- endif -%}
    </div>
    <div class="about__copy">
      {%- if section.settings.content != blank -%}
        <div class="rte">{{ section.settings.content }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fresco Home About",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "About Section Settings"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Text",
      "info": "Optional small text above the heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We turn Fresh Harvests into reliable superior quality products."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Fresco Flavors is the in-house freeze-dried organic herbs brand of Freezedry Harvest EPZ Kenya Ltd, one of Africa's leading freeze-drying facilities. We grow our own herbs and specialty ingredients in over 14 acres of our organic farms in Kenya.</p><p>Every crop is carefully tended, harvested at peak ripeness, and delivered to our Freezedry Harvest facility within hours – preserving the integrity of every herb. This enables us to deliver premium farm-to-table products to the world in a format that is stable, convenient, and uncompromising in quality beyond fresh.</p><p>We lock in the flavor so those once-elusive dishes can now be enjoyed everyday, the result? Rich, aromatic herbs directly to your kitchen. By perfectly freeze-drying, we offer you extended shelf-life and guarantee a year-round supply and culinary convenience right at your fingertips.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "More About Us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Fresco Home About"
    }
  ]
}
{% endschema %}
