{{ 'fresco/contact-styles.css' | asset_url | stylesheet_tag }}

<section class="container contact-grid">
  <div class="contact-form-card">
    {%- if section.settings.heading != blank -%}
      <h1>{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {% form 'contact', class: 'contact-form' %}
      {%- if form.posted_successfully? -%}
        <div class="contact-form__message contact-form__message--success">
          <p>
            {{
              section.settings.success_message
              | default: 'Thank you for your message. We will get back to you within 24 hours.'
            }}
          </p>
        </div>
      {%- elsif form.errors -%}
        <div class="contact-form__message contact-form__message--error">
          <p>{{ 'templates.contact.form.error_heading' | t }}</p>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#ContactForm-{{ field }}">
                    {{ form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] }}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <label>
        {{ section.settings.name_label | default: 'Full name' }}
        <input
          type="text"
          name="contact[name]"
          id="ContactForm-name"
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          placeholder="{{ section.settings.name_placeholder | default: 'Your Name' }}"
          required
        >
      </label>

      <label>
        {{ section.settings.email_label | default: 'Email' }}
        <input
          type="email"
          name="contact[email]"
          id="ContactForm-email"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          placeholder="{{ section.settings.email_placeholder | default: 'example@gmail.com' }}"
          required
        >
      </label>

      <label>
        {{ section.settings.message_label | default: 'Message' }}
        <textarea
          name="contact[body]"
          id="ContactForm-body"
          rows="5"
          placeholder="{{ section.settings.message_placeholder | default: 'Tell us how we can help...' }}"
          required
        >{% if form.body %}{{ form.body }}{% endif %}</textarea>
      </label>

      <button type="submit" class="contact-btn">
        {{ section.settings.button_text | default: 'Send message' }}
        <i class="fa-solid fa-arrow-right"></i>
      </button>
    {% endform %}
  </div>

  <div class="contact-info-card">
    {%- if section.settings.info_eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.info_eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.info_heading != blank -%}
      <h2>{{ section.settings.info_heading }}</h2>
    {%- endif -%}

    <div class="contact-info-list">
      {%- if section.settings.phone != blank -%}
        <article>
          <i class="fa-solid fa-phone"></i>
          <div>
            <a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a>
          </div>
        </article>
      {%- endif -%}

      {%- if section.settings.email != blank -%}
        <article>
          <i class="fa-solid fa-envelope"></i>
          <div>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </div>
        </article>
      {%- endif -%}

      {%- if section.settings.address != blank -%}
        <article>
          <i class="fa-solid fa-location-dot"></i>
          <div>
            <div class="rte">{{ section.settings.address }}</div>
          </div>
        </article>
      {%- endif -%}
    </div>

    {%- if section.settings.show_socials -%}
      <div class="contact-socials">
        {%- if section.settings.socials_heading != blank -%}
          <h3>{{ section.settings.socials_heading }}</h3>
        {%- endif -%}
        <div class="contact-socials-list">
          {%- if section.settings.facebook_url != blank -%}
            <a href="{{ section.settings.facebook_url }}" aria-label="Facebook">
              <i class="fa-brands fa-facebook"></i>
            </a>
          {%- endif -%}
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" aria-label="Instagram">
              <i class="fa-brands fa-instagram"></i>
            </a>
          {%- endif -%}
          {%- if section.settings.youtube_url != blank -%}
            <a href="{{ section.settings.youtube_url }}" aria-label="YouTube">
              <i class="fa-brands fa-youtube"></i>
            </a>
          {%- endif -%}
          {%- if section.settings.linkedin_url != blank -%}
            <a href="{{ section.settings.linkedin_url }}" aria-label="LinkedIn">
              <i class="fa-brands fa-linkedin"></i>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.support_hours != blank -%}
      <p class="contact-hours">{{ section.settings.support_hours }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Fresco Contact Form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Form Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us Today"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "We respond within 24 hours"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name Field Label",
      "default": "Full name"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name Placeholder",
      "default": "Your Name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email Field Label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Placeholder",
      "default": "example@gmail.com"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message Field Label",
      "default": "Message"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message Placeholder",
      "default": "Tell us how we can help..."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Submit Button Text",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thank you for your message. We will get back to you within 24 hours."
    },
    {
      "type": "header",
      "content": "Contact Info Settings"
    },
    {
      "type": "text",
      "id": "info_eyebrow",
      "label": "Info Eyebrow Text",
      "default": "Direct contact"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "Info Heading",
      "default": "Reach out to us"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+1 (901) 896-5814"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "info@frescoflavors.com"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address",
      "default": "<p>7910 Moriarty Rd<br />Cordova, TN 38018</p>"
    },
    {
      "type": "header",
      "content": "Social Media Settings"
    },
    {
      "type": "checkbox",
      "id": "show_socials",
      "label": "Show Social Media Links",
      "default": true
    },
    {
      "type": "text",
      "id": "socials_heading",
      "label": "Social Media Heading",
      "default": "Follow Us"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },
    {
      "type": "text",
      "id": "support_hours",
      "label": "Support Hours",
      "default": "Support hours: Monday–Friday, 9am–6pm EST"
    }
  ],
  "presets": [
    {
      "name": "Fresco Contact Form"
    }
  ]
}
{% endschema %}
