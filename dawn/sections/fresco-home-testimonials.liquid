
<section class="testimonials">
  <div class="container">
    <div class="testimonials__card">
      <figure class="testimonials__media">
        {%- if section.settings.media_image != blank -%}
          <img
            src="{{ section.settings.media_image | image_url: width: 800 }}"
            alt="{{ section.settings.media_image.alt | default: 'Chef testimonial' | escape }}"
            loading="lazy"
            width="800"
            height="auto"
          >
        {%- endif -%}

        {%- if section.settings.video_url != blank -%}
          <button class="video-play" id="chef-video-play-{{ section.id }}" aria-label="Play video">
            <i class="fa-solid fa-play"></i>
          </button>
        {%- endif -%}
      </figure>

      <div class="testimonials__content">
        {%- if section.settings.heading != blank -%}
          <h3 class="testimonials__heading">{{ section.settings.heading }}</h3>
        {%- endif -%}

        <div class="swiper testimonials__swiper" data-section-id="{{ section.id }}">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              {%- if block.type == 'testimonial' -%}
                <div class="swiper-slide testimonials__slide" {{ block.shopify_attributes }}>
                  <div class="testimonials__quote-icon">
                    <i class="fa-solid fa-quote-left"></i>
                  </div>
                  {%- if block.settings.quote != blank -%}
                    <p class="testimonials__quote">{{ block.settings.quote }}</p>
                  {%- endif -%}
                  <div class="testimonials__author">
                    {%- if block.settings.author_name != blank -%}
                      <strong>{{ block.settings.author_name }}</strong>
                    {%- endif -%}
                    {%- if block.settings.author_title != blank -%}
                      <span>{{ block.settings.author_title }}</span>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <div class="testimonials__nav">
          <button
            class="testimonials__arrow testimonials__arrow--prev"
            aria-label="Previous testimonial"
            data-section-id="{{ section.id }}"
          >
            <i class="fa-solid fa-arrow-left"></i>
          </button>
          <button
            class="testimonials__arrow testimonials__arrow--next"
            aria-label="Next testimonial"
            data-section-id="{{ section.id }}"
          >
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{%- if section.settings.video_url != blank -%}
  <div class="chefs-overlay-video" id="chef-overlay-video-{{ section.id }}">
    <div class="chefs-overlay-video__content">
      <iframe
        src="{{ section.settings.video_url }}"
        title="Video player"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>

      <button class="close-button" id="chef-close-button-{{ section.id }}" aria-label="Close video">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Fresco Home Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Testimonials Section Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CHEF'S VERDICT"
    },
    {
      "type": "image_picker",
      "id": "media_image",
      "label": "Media Image",
      "info": "Image displayed on the left side"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "info": "YouTube or Vimeo embed URL (e.g., https://www.youtube.com/embed/VIDEO_ID)"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "\"It's the extended shelf-life for me. Fresh herbs last for days, at best, but freeze-dried herbs we are looking at up to two years before the seal is broken. This shelf-life reduces to two-weeks on usage, which still eliminates spoilage and daily purchasing. I run a seasonal restaurant and it's painful to always have to throw away ingredients.\""
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Henali Shah"
        },
        {
          "type": "text",
          "id": "author_title",
          "label": "Author Title",
          "default": "Chef"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresco Home Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "\"It's the extended shelf-life for me. Fresh herbs last for days, at best, but freeze-dried herbs we are looking at up to two years before the seal is broken. This shelf-life reduces to two-weeks on usage, which still eliminates spoilage and daily purchasing. I run a seasonal restaurant and it's painful to always have to throw away ingredients.\"",
            "author_name": "Henali Shah",
            "author_title": "Chef"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "\"Same flavor profiles, everytime! As good as fresh, isn't it? Expect Fresco Flavors products are unaffected by weather or logistics. I love using their jar herbs, no washing, chopping or water, saves me a lot of prep time for my ever busy kitchen here in Tennessee.\"",
            "author_name": "Richards Brown",
            "author_title": "Restaurant Owner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
