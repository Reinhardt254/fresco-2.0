{{ 'fresco/recipe-styles.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<main class="recipe-main section-{{ section.id }}-padding">
  <article class="recipe-article">
    <section class="recipe-hero">
      <div class="recipe-hero__image">
        {%- if article.image != blank -%}
          <img
            src="{{ article.image | image_url: width: 2000 }}"
            alt="{{ article.image.alt | default: article.title | escape }}"
            width="2000"
            height="auto"
            loading="eager"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'recipe-hero-image' }}
        {%- endif -%}
      </div>
      <div class="recipe-hero__content">
        <div class="container">
          {%- if article.tags.size > 0 -%}
            <span class="recipe-category">{{ article.tags.first }}</span>
          {%- endif -%}

          <h1>{{ article.title }}</h1>

          {%- if article.excerpt != blank -%}
            <p class="recipe-description">{{ article.excerpt }}</p>
          {%- elsif article.summary != blank -%}
            <p class="recipe-description">{{ article.summary }}</p>
          {%- endif -%}

          <div class="recipe-meta">
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'meta_item' -%}
                  <div class="recipe-meta__item" {{ block.shopify_attributes }}>
                    {%- if block.settings.icon != blank -%}
                      <i class="{{ block.settings.icon }}"></i>
                    {%- endif -%}
                    <span>{{ block.settings.value }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- comment -%} Default meta items {%- endcomment -%}
              {%- if article.published_at != blank -%}
                <div class="recipe-meta__item">
                  <i class="fa-solid fa-clock"></i>
                  <span>{{ article.published_at | date: '%B %d, %Y' }}</span>
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      </div>
    </section>
  </article>
</main>

{% schema %}
{
  "name": "Fresco Recipe Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "meta_item",
      "name": "Meta Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon Class",
          "default": "fa-solid fa-clock",
          "info": "Font Awesome icon class (e.g., fa-solid fa-clock)"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "10 minutes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresco Recipe Hero",
      "blocks": [
        {
          "type": "meta_item",
          "settings": {
            "icon": "fa-solid fa-clock",
            "value": "10 minutes"
          }
        },
        {
          "type": "meta_item",
          "settings": {
            "icon": "fa-solid fa-users",
            "value": "2 servings"
          }
        },
        {
          "type": "meta_item",
          "settings": {
            "icon": "fa-solid fa-signal",
            "value": "Easy"
          }
        }
      ]
    }
  ]
}
{% endschema %}
