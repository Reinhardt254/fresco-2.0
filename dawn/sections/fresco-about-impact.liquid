{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="about-impact section-{{ section.id }}-padding">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="header">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="products__description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="impact-stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat_card' -%}
            <div class="stat-card" {{ block.shopify_attributes }}>
              {%- if block.settings.number != blank -%}
                <div class="stat-card__number">{{ block.settings.number }}</div>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <div class="stat-card__label">{{ block.settings.label }}</div>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p>{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Fresco About Impact",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Footprint"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every purchase supports sustainable agriculture and community development in Kenya."
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "stat_card",
      "name": "Stat Card",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "15+",
          "info": "The main statistic number (e.g., 15+, 20+, 100%)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "ACRES of Organic Farms",
          "info": "Uppercase label text"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Grown and managed using sustainable, regenerative agriculture methods."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresco About Impact",
      "blocks": [
        {
          "type": "stat_card",
          "settings": {
            "number": "15+",
            "label": "ACRES of Organic Farms",
            "description": "Grown and managed using sustainable, regenerative agriculture methods."
          }
        },
        {
          "type": "stat_card",
          "settings": {
            "number": "20+",
            "label": "Products",
            "description": "Freeze-dried herbs, infused condiments, and pure Kenyan flavors."
          }
        },
        {
          "type": "stat_card",
          "settings": {
            "number": "24 HR",
            "label": "Harvest to Freeze",
            "description": "Maximum time from picking to preservation for peak freshness."
          }
        },
        {
          "type": "stat_card",
          "settings": {
            "number": "100%",
            "label": "Natural",
            "description": "No additives, no preservatives, and no GMOs—just real ingredients."
          }
        }
      ]
    }
  ]
}
{% endschema %}
