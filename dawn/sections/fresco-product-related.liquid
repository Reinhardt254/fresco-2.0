{{ 'fresco/product-styles.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="product-related section-{{ section.id }}-padding">
  <div class="container">
    <div class="related-header">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- else -%}
        <h2>Related products</h2>
      {%- endif -%}
    </div>

    {%- liquid
      assign related_products = ''
      assign related_count = 0
      assign max_limit = section.settings.products_to_show | plus: 1

      comment
        Get related products from the same collection
      endcomment
      if product.collections.size > 0
        assign first_collection = product.collections.first
        for related_product in first_collection.products limit: max_limit
          unless related_product.id == product.id
            if related_products == blank
              assign related_products = related_product.handle
            else
              assign related_products = related_products | append: ',' | append: related_product.handle
            endif
            assign related_count = related_count | plus: 1
            if related_count >= section.settings.products_to_show
              break
            endif
          endunless
        endfor
      endif

      if related_products != blank
        assign related_handles = related_products | split: ','
      else
        assign related_handles = '' | split: ','
      endif
    -%}

    {%- if related_handles.size > 0 -%}
      <div class="related-grid">
        {%- for handle in related_handles limit: section.settings.products_to_show -%}
          {%- assign related_product = all_products[handle] -%}
          {%- if related_product != blank -%}
            <article class="related-card">
              <a href="{{ related_product.url }}">
                {%- if related_product.featured_image != blank -%}
                  <img
                    src="{{ related_product.featured_image | image_url: width: 600 }}"
                    alt="{{ related_product.featured_image.alt | default: related_product.title | escape }}"
                    width="600"
                    height="auto"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'related-card-image' }}
                {%- endif -%}
              </a>
              <h3>
                <a href="{{ related_product.url }}">{{ related_product.title }}</a>
              </h3>
              <p class="related-price">{{ related_product.price | money }} each</p>
              {%- if related_product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                <p class="related-stock">
                  {{ related_product.selected_or_first_available_variant.inventory_quantity }} items in stock
                </p>
              {%- elsif related_product.available == false -%}
                <p class="related-stock" style="color: #d32f2f;">Out of stock</p>
              {%- else -%}
                <p class="related-stock">In stock</p>
              {%- endif -%}
              {%- if related_product.available -%}
                {%- liquid
                  assign fallback_contact_url = pages['contact'].url
                  if fallback_contact_url == blank
                    assign fallback_contact_url = routes.root_url | append: 'pages/contact'
                  endif

                  assign buy_now_url = section.settings.buy_now_url | default: fallback_contact_url
                -%}

                <a class="product-card__btn" href="{{ buy_now_url }}">{{ section.settings.buy_now_label | escape }}</a>

                {% comment %}
                  Original Add to cart (kept for easy retrieval)
                  <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="id" value="{{ related_product.selected_or_first_available_variant.id }}">
                    <button type="submit">Add to cart</button>
                  </form>
                {% endcomment %}
              {%- else -%}
                <button type="button" disabled>Out of stock</button>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%} Fallback: Show products from all collections if no related products found {%- endcomment -%}
      <div class="related-grid">
        {%- for related_product in collections.all.products limit: section.settings.products_to_show -%}
          {%- unless related_product.id == product.id -%}
            <article class="related-card">
              <a href="{{ related_product.url }}">
                {%- if related_product.featured_image != blank -%}
                  <img
                    src="{{ related_product.featured_image | image_url: width: 600 }}"
                    alt="{{ related_product.featured_image.alt | default: related_product.title | escape }}"
                    width="600"
                    height="auto"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'related-card-image' }}
                {%- endif -%}
              </a>
              <h3>
                <a href="{{ related_product.url }}">{{ related_product.title }}</a>
              </h3>
              <p class="related-price">{{ related_product.price | money }} each</p>
              {%- if related_product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                <p class="related-stock">
                  {{ related_product.selected_or_first_available_variant.inventory_quantity }} items in stock
                </p>
              {%- elsif related_product.available == false -%}
                <p class="related-stock" style="color: #d32f2f;">Out of stock</p>
              {%- else -%}
                <p class="related-stock">In stock</p>
              {%- endif -%}
              {%- if related_product.available -%}
                {%- liquid
                  assign fallback_contact_url = pages['contact'].url
                  if fallback_contact_url == blank
                    assign fallback_contact_url = routes.root_url | append: 'pages/contact'
                  endif

                  assign buy_now_url = section.settings.buy_now_url | default: fallback_contact_url
                -%}

                <a class="product-card__btn" href="{{ buy_now_url }}">{{ section.settings.buy_now_label | escape }}</a>

                {% comment %}
                  Original Add to cart (kept for easy retrieval)
                  <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="id" value="{{ related_product.selected_or_first_available_variant.id }}">
                    <button type="submit">Add to cart</button>
                  </form>
                {% endcomment %}
              {%- else -%}
                <button type="button" disabled>Out of stock</button>
              {%- endif -%}
            </article>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Fresco Product Related",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related products"
    },
    {
      "type": "url",
      "id": "buy_now_url",
      "label": "Buy now link",
      "info": "Where the Buy now button should go (e.g., your Contact page)."
    },
    {
      "type": "text",
      "id": "buy_now_label",
      "label": "Buy now button label",
      "default": "Buy now"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Fresco Product Related"
    }
  ]
}
{% endschema %}
