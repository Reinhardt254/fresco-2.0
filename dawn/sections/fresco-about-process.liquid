{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="about-process section-{{ section.id }}-padding">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="header">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="products__description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="process-timeline">
        {%- for block in section.blocks -%}
          {%- if block.type == 'process_step' -%}
            <div class="process-step" {{ block.shopify_attributes }}>
              {%- if block.settings.step_number != blank -%}
                <div class="process-step__number">{{ block.settings.step_number }}</div>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3>{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.content != blank -%}
                <p>{{ block.settings.content }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Fresco About Process",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Process"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "From field to freeze-dry, we maintain quality at every step."
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "process_step",
      "name": "Process Step",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step Number",
          "default": "01",
          "info": "Enter the step number (e.g., 01, 02, 03)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Organic Cultivation"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content",
          "default": "We nurture every herb and ingredient through organic, sustainable farming practices that protect the land and environment from the very first seed."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresco About Process",
      "blocks": [
        {
          "type": "process_step",
          "settings": {
            "step_number": "01",
            "heading": "Organic Cultivation",
            "content": "We nurture every herb and ingredient through organic, sustainable farming practices that protect the land and environment from the very first seed."
          }
        },
        {
          "type": "process_step",
          "settings": {
            "step_number": "02",
            "heading": "Peak Harvesting",
            "content": "Our crops are hand-picked at peak ripeness, capturing nature's fullest flavor, highest nutritional value, and aroma in every harvest."
          }
        },
        {
          "type": "process_step",
          "settings": {
            "step_number": "03",
            "heading": "Freeze-Dried at Source",
            "content": "Immediately after harvest, produce is freeze-dried on-site to preserve essential oils, nutrients, and true garden-fresh quality."
          }
        },
        {
          "type": "process_step",
          "settings": {
            "step_number": "04",
            "heading": "Traceable Packaging",
            "content": "We pack small batches with complete traceability, ensuring food safety, integrity, and transparency from our facility to your kitchen."
          }
        }
      ]
    }
  ]
}
{% endschema %}
