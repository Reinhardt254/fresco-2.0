{{ 'fresco/contact-styles.css' | asset_url | stylesheet_tag }}

<section class="contact-faq">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    
    <div class="accordion">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
          <details {{ block.shopify_attributes }}>
            <summary>
              {{ block.settings.question }}
              <i class="fa-solid fa-plus"></i>
            </summary>
            <div class="rte">
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fresco Contact FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "FAQ Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Do you ship internationally?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes, our fulfillment partners handle cold-chain logistics for 12+ countries. Share your location and volume for a tailored quote.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresco Contact FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes, our fulfillment partners handle cold-chain logistics for 12+ countries. Share your location and volume for a tailored quote.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What's your minimum wholesale order?",
            "answer": "<p>Standard minimums start at 50 units per SKU, with options for pilot runs during new menu development.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can you create custom blends?",
            "answer": "<p>Our culinary lab collaborates on custom freeze-dried blends, packaging, and private-label launches.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

