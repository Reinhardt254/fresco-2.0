{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .products {
    text-align: center;
    padding: 4rem 0 4rem 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .products .container {
    width: 90%;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    gap: 0rem;
    padding: 0;
    background-color: #ffffff !important;
  }

  .products .header {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    gap: 0rem;
    padding: 0;
    margin: 0;
    max-width: 800px;
    width: 100%;
  }

  .products__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    width: 100%;
  }

  @media (max-width: 1200px) {
    .products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 1024px) {
    .products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .products__grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
-%}

<section class="products">
  <div class="container">
    <div class="header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="products__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="products__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="products__grid">
        {%- for product in collection.products limit: products_to_show -%}
          <article class="product-card">
            <a href="{{ product.url }}" class="product-card__link">
              {%- if product.featured_image != blank -%}
                <img
                  class="product-card__image"
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="600"
                  height="auto"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
              {%- endif -%}
            </a>

            {%- if product.price != blank -%}
              <p class="product-card__price">
                {{ product.price | money -}}
                {%- if product.compare_at_price > product.price %} / each{% endif %}
              </p>
            {%- endif -%}

            <h3>
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>

            {%- if product.available == false -%}
              <p class="product-card__stock">Out of stock</p>
            {%- endif -%}

            <div class="product-card__actions">
              {%- liquid
                assign fallback_contact_url = pages.contact.url
                if fallback_contact_url == blank
                  assign fallback_contact_url = routes.root_url | append: 'pages/contact'
                endif

                assign buy_now_url = section.settings.buy_now_url | default: fallback_contact_url
              -%}

              {%- if product.available -%}
                <a class="product-card__btn" href="{{ buy_now_url }}">{{ section.settings.buy_now_label | escape }}</a>
              {%- else -%}
                <button type="button" class="product-card__btn" disabled>Sold out</button>
              {%- endif -%}

              {% comment %}
                Original Add to cart (kept for easy retrieval)
                <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="product-form">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button
                    type="submit"
                    class="product-card__btn"
                    name="add"
                    {% unless product.available %}
                      disabled
                    {% endunless %}
                  >
                    {%- if product.available -%}
                      Add to cart
                    {%- else -%}
                      Sold out
                    {%- endif -%}
                  </button>
                </form>
              {% endcomment %}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="products__grid">
        {%- for i in (1..4) -%}
          <article class="product-card">
            {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
            <p class="product-card__price">$0.00</p>
            <h3>Sample Product {{ i }}</h3>
            <div class="product-card__actions">
              <button class="product-card__btn" type="button">Buy now</button>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Fresco Home Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Products Section Settings"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "info": "Optional small text above the heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Products"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "100% Organic Herbs and Specialty Ingredients for Food Service and Home Use - Freeze-dried To Perfection."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Select a collection to display products from"
    },
    {
      "type": "url",
      "id": "buy_now_url",
      "label": "Buy now link",
      "info": "Where the Buy now button should go (e.g., your Contact page)."
    },
    {
      "type": "text",
      "id": "buy_now_label",
      "label": "Buy now button label",
      "default": "Buy now"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 4,
      "label": "Products to show",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Fresco Home Products"
    }
  ]
}
{% endschema %}
