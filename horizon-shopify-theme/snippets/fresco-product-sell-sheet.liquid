{% comment %}
  Product sell sheet from product metafields (namespace `custom`). Data-only; layout matches product-details/index.html.

  Spec cards: up to 3 cards. Each card uses single-line + list fields (no JSON).
  - Standard card: `sell_sheet_spec_N_meta_label` + `sell_sheet_spec_N_meta_value` (one meta line, nested spans like basil).
  - Profile card: set `sell_sheet_spec_N_subtitle` (non-blank) → uses profile chips / lead / pills metafields; ignores badge, meta, rows for that slot.
  - Badge: optional `Highlight|Rest` (first `|` → line break between lines in the badge).
  - Rows list: each line `Label|value` (first `|` separates dt from dd; additional `|` characters stay in the value).

  @param product {object} Product (required)
  @param section_label {string} aria-label for the section
  @param empty_text {string} Empty state when tab is on but no sell-sheet content
{% endcomment %}
{%- liquid
  assign mf = product.metafields.custom
  assign hero = mf.sell_sheet_hero_image.value
  assign tag_img = mf.sell_sheet_tag_image.value
  assign headline = mf.sell_sheet_headline.value
  assign intro = mf.sell_sheet_intro.value
  assign info_bullets = mf.sell_sheet_info_bullets.value
  assign usage_images = mf.sell_sheet_usage_images.value
  assign usage_captions = mf.sell_sheet_usage_captions.value
  assign more_heading = mf.sell_sheet_more_heading.value | default: 'Information'
  assign more_bullets = mf.sell_sheet_more_bullets.value
  assign more_image = mf.sell_sheet_more_image.value
  assign cta_text = mf.sell_sheet_cta_text.value

  assign s1_title = mf.sell_sheet_spec_1_title.value
  assign s1_subtitle = mf.sell_sheet_spec_1_subtitle.value
  assign s1_meta_label = mf.sell_sheet_spec_1_meta_label.value
  assign s1_meta_value = mf.sell_sheet_spec_1_meta_value.value
  assign s1_badge = mf.sell_sheet_spec_1_badge.value
  assign s1_rows = mf.sell_sheet_spec_1_rows.value
  assign s1_profile_chips = mf.sell_sheet_spec_1_profile_chips.value
  assign s1_profile_lead = mf.sell_sheet_spec_1_profile_lead.value
  assign s1_profile_foot_label = mf.sell_sheet_spec_1_profile_foot_label.value
  assign s1_profile_pills = mf.sell_sheet_spec_1_profile_pills.value
  assign s2_title = mf.sell_sheet_spec_2_title.value
  assign s2_subtitle = mf.sell_sheet_spec_2_subtitle.value
  assign s2_meta_label = mf.sell_sheet_spec_2_meta_label.value
  assign s2_meta_value = mf.sell_sheet_spec_2_meta_value.value
  assign s2_badge = mf.sell_sheet_spec_2_badge.value
  assign s2_rows = mf.sell_sheet_spec_2_rows.value
  assign s2_profile_chips = mf.sell_sheet_spec_2_profile_chips.value
  assign s2_profile_lead = mf.sell_sheet_spec_2_profile_lead.value
  assign s2_profile_foot_label = mf.sell_sheet_spec_2_profile_foot_label.value
  assign s2_profile_pills = mf.sell_sheet_spec_2_profile_pills.value
  assign s3_title = mf.sell_sheet_spec_3_title.value
  assign s3_subtitle = mf.sell_sheet_spec_3_subtitle.value
  assign s3_meta_label = mf.sell_sheet_spec_3_meta_label.value
  assign s3_meta_value = mf.sell_sheet_spec_3_meta_value.value
  assign s3_badge = mf.sell_sheet_spec_3_badge.value
  assign s3_rows = mf.sell_sheet_spec_3_rows.value
  assign s3_profile_chips = mf.sell_sheet_spec_3_profile_chips.value
  assign s3_profile_lead = mf.sell_sheet_spec_3_profile_lead.value
  assign s3_profile_foot_label = mf.sell_sheet_spec_3_profile_foot_label.value
  assign s3_profile_pills = mf.sell_sheet_spec_3_profile_pills.value

  assign has_spec_cards = false
  if s1_title != blank or s2_title != blank or s3_title != blank
    assign has_spec_cards = true
  endif

  assign has_any = false
  if hero != blank
    assign has_any = true
  endif
  if headline != blank or intro != blank
    assign has_any = true
  endif
  if info_bullets != blank and info_bullets.size > 0
    assign has_any = true
  endif
  if usage_images != blank and usage_images.size > 0
    assign has_any = true
  endif
  if has_spec_cards
    assign has_any = true
  endif
  if more_bullets != blank and more_bullets.size > 0
    assign has_any = true
  endif
  if more_image != blank
    assign has_any = true
  endif
  if cta_text != blank
    assign has_any = true
  endif

  assign sell_sheet_more_block = false
  if more_image != blank
    assign sell_sheet_more_block = true
  endif
  if more_bullets != blank and more_bullets.size > 0
    assign sell_sheet_more_block = true
  endif
  if sell_sheet_more_block
    assign has_any = true
  endif
-%}

{%- unless has_any -%}
  <p class="product-details-tab-content sell-sheet-tab-empty">{{ empty_text | escape }}</p>
{%- else -%}
  <section class="sell-sheet" aria-label="{{ section_label | escape }}">
    <div class="sell-sheet__page">
      <div class="sell-sheet__topbar" aria-hidden="true"></div>

      <header class="sell-sheet__header">
        <div class="sell-sheet__hero">
          {%- if hero != blank -%}
            <img
              class="sell-sheet__hero-image"
              src="{{ hero | image_url: width: 1600 }}"
              alt="{{ hero.alt | default: product.title | escape }}"
              loading="lazy"
              width="1200"
              height="675"
            >
          {%- endif -%}
        </div>

        {%- if tag_img != blank -%}
          <div class="sell-sheet__tag">
            <div class="sell-sheet__tag-image">
              <img
                src="{{ tag_img | image_url: width: 200 }}"
                alt=""
                loading="lazy"
                width="120"
                height="120"
              >
            </div>
          </div>
        {%- endif -%}
      </header>

      <main class="sell-sheet__content">
        {%- if headline != blank or intro != blank -%}
          <div class="sell-sheet__copy">
            {%- if headline != blank -%}
              <h2 class="sell-sheet__headline">{{ headline | escape }}</h2>
            {%- endif -%}
            {%- if intro != blank -%}
              <p class="sell-sheet__body">{{ intro | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if usage_images != blank and usage_images.size > 0 -%}
          <div class="sell-sheet__uses_thumbs">
            <div class="sell-sheet__thumbs" aria-label="Product usage">
              {%- for img in usage_images -%}
                {%- liquid
                  assign cap = ''
                  if usage_captions != blank
                    assign cap = usage_captions[forloop.index0]
                  endif
                  assign thumb_alt = cap
                  if thumb_alt == blank
                    assign thumb_alt = img.alt
                  endif
                  if thumb_alt == blank
                    assign thumb_alt = 'Usage'
                  endif
                -%}
                <div class="sell-sheet__thumb-item">
                  <figure class="sell-sheet__thumb">
                    <img
                      src="{{ img | image_url: width: 600 }}"
                      alt="{{ thumb_alt | escape }}"
                      loading="lazy"
                      width="400"
                      height="400"
                    >
                  </figure>
                  {%- if cap != blank -%}
                    <div class="sell-sheet__thumb-label">{{ cap | escape }}</div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if info_bullets != blank and info_bullets.size > 0 -%}
          <div class="sell-sheet__copy">
            <h2 class="sell-sheet__sub-headline">Information</h2>
            <ul class="sell-sheet__info-list">
              {%- for line in info_bullets -%}
                <li>{{ line | escape }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if has_spec_cards -%}
          <div
            class="sell-sheet__uses_thumbs_details"
            aria-label="Product specifications"
          >
            {% render 'fresco-sell-sheet-spec-card',
              product: product,
              card_index: 1,
              title: s1_title,
              subtitle: s1_subtitle,
              meta_label: s1_meta_label,
              meta_value: s1_meta_value,
              badge_line: s1_badge,
              rows: s1_rows,
              profile_chips: s1_profile_chips,
              profile_lead: s1_profile_lead,
              profile_foot_label: s1_profile_foot_label,
              profile_pills: s1_profile_pills
            %}
            {% render 'fresco-sell-sheet-spec-card',
              product: product,
              card_index: 2,
              title: s2_title,
              subtitle: s2_subtitle,
              meta_label: s2_meta_label,
              meta_value: s2_meta_value,
              badge_line: s2_badge,
              rows: s2_rows,
              profile_chips: s2_profile_chips,
              profile_lead: s2_profile_lead,
              profile_foot_label: s2_profile_foot_label,
              profile_pills: s2_profile_pills
            %}
            {% render 'fresco-sell-sheet-spec-card',
              product: product,
              card_index: 3,
              title: s3_title,
              subtitle: s3_subtitle,
              meta_label: s3_meta_label,
              meta_value: s3_meta_value,
              badge_line: s3_badge,
              rows: s3_rows,
              profile_chips: s3_profile_chips,
              profile_lead: s3_profile_lead,
              profile_foot_label: s3_profile_foot_label,
              profile_pills: s3_profile_pills
            %}
          </div>
        {%- endif -%}

        {%- if sell_sheet_more_block -%}
          <div class="additional-information">
            <div class="additional-information-grid">
              {%- if more_bullets != blank and more_bullets.size > 0 -%}
                <div class="informatio-card">
                  <div class="sell-sheet__copy">
                    <h2 class="sell-sheet__sub-headline">{{ more_heading | escape }}</h2>
                    <ul class="sell-sheet__info-list">
                      {%- for line in more_bullets -%}
                        <li>{{ line | escape }}</li>
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>
              {%- endif -%}
              {%- if more_image != blank -%}
                <div class="informatio-card">
                  <img
                    src="{{ more_image | image_url: width: 900 }}"
                    alt=""
                    loading="lazy"
                    width="600"
                    height="400"
                  >
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="sell-sheet__footer">
          <div class="sell-sheet__brand">
            <div class="sell-sheet__brand-mark">
              Fresco Flavors<span aria-hidden="true">®</span>
            </div>
            <div class="sell-sheet__brand-sub">Herbs &amp; Spices</div>
            <div class="sell-sheet__contact">
              <div class="sell-sheet__contact-line">info@frescoflavors.com</div>
              <div class="sell-sheet__contact-line">frescoflavors.com • +1 (901) 896-5814</div>
            </div>
          </div>
          {%- if cta_text != blank -%}
            <div class="sell-sheet__cta">
              <div class="sell-sheet__cta-text">{{ cta_text | escape }}</div>
            </div>
          {%- endif -%}
        </div>
      </main>
    </div>
  </section>
{%- endunless -%}
