<section class="product-page-hero" {{ section.shopify_attributes }}>
  <div class="product-page-hero-inner">
    <div class="product-page-hero-media" aria-hidden="true">
      {%- if section.settings.hero_image != blank -%}
        <img
          class="product-page-hero-image"
          src="{{ section.settings.hero_image | image_url: width: 2400 }}"
          alt="{{ section.settings.hero_image.alt | default: section.settings.hero_image_alt | escape }}"
          width="2400"
          height="1350"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        >
      {%- elsif section.settings.hero_image_url_fallback != blank -%}
        <img
          class="product-page-hero-image"
          src="{{ section.settings.hero_image_url_fallback }}"
          alt="{{ section.settings.hero_image_alt | escape }}"
          width="2400"
          height="1350"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        >
      {%- endif -%}
    </div>

    <div class="product-page-hero-content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="product-page-hero-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="product-page-hero-title">
        {{ section.settings.title_main }}
        <span class="product-page-hero-title-accent">{{ section.settings.title_accent }}</span>
      </h1>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fresco Collection Hero",
  "tag": "section",
  "class": "section-fresco-collection-hero",
  "enabled_on": {
    "templates": ["collection", "list-collections"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image"
    },
    {
      "type": "text",
      "id": "hero_image_url_fallback",
      "label": "Hero image URL fallback",
      "default": "https://harvestepz.com/wp-content/uploads/2026/05/Untitled-design-1-1.png"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text",
      "default": "Fresco Flavors herbs"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optional)",
      "info": "Small line above the title. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "title_main",
      "label": "Title (first line)",
      "default": "Fresco Flavors"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Title accent (highlight line)",
      "default": "Freeze-Dried Herbs"
    }
  ],
  "presets": [
    {
      "name": "Fresco Collection Hero",
      "settings": {
        "hero_image_url_fallback": "https://harvestepz.com/wp-content/uploads/2026/05/Untitled-design-1-1.png",
        "hero_image_alt": "Fresco Flavors herbs",
        "title_main": "Fresco Flavors",
        "title_accent": "Freeze-Dried Herbs"
      }
    }
  ]
}
{% endschema %}
