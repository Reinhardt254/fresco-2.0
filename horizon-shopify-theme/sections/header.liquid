{%- comment -%}
  Fresco-style header. Navigation is editor-driven via section settings + blocks.
{%- endcomment -%}

{% liquid
  assign search_style = 'none'
  if section.settings.show_search
    assign search_style = 'modal'
  endif

  assign home_url = section.settings.home_url
  if home_url == blank
    assign home_url = routes.root_url
  endif
  assign explore_url = section.settings.explore_url
  if explore_url == blank
    assign explore_url = '/pages/about'
  endif
  assign contact_url = section.settings.contact_url
  if contact_url == blank
    assign contact_url = '/pages/contact'
  endif
  assign shop_url = section.settings.shop_url
  if shop_url == blank
    assign shop_url = routes.all_products_collection_url
  endif
%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

<header class="site-header" id="header-component">
  <div class="site-header-container">
    <div class="menu-toggle-container">
      <button
        class="menu-toggle"
        aria-label="{{ 'accessibility.menu' | t }}"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="visually-hidden">{{ 'accessibility.menu' | t }}</span>
        <span class="menu-toggle__bar"></span>
      </button>
    </div>

    {%- comment -%} Desktop left nav {%- endcomment -%}
    <div class="nav left-nav desktop-nav">
      <div class="nav-links">
        <a href="{{ home_url }}" class="{% if request.path == home_url %}active{% endif %}">
          {{ section.settings.home_label | escape }}
        </a>
        <div class="nav-dropdown">
          <a
            href="{{ explore_url }}"
            class="nav-dropdown-trigger{% if request.path contains explore_url %} active{% endif %}"
            {% if request.path contains explore_url %}aria-current="page"{% endif %}
          >
            {{ section.settings.explore_label | escape }}
          </a>
          <div class="nav-dropdown-menu">
            <div class="nav-dropdown-menu-content">
              {%- for block in section.blocks -%}
                <a href="{{ block.settings.url }}" class="dropdown-section" {{ block.shopify_attributes }}>
                  <div class="dropdown-icon">
                    {%- if block.settings.icon_image != blank -%}
                      {{
                        block.settings.icon_image
                        | image_url: width: 200
                        | image_tag:
                          alt: block.settings.title,
                          loading: 'lazy',
                          widths: '60, 100, 140, 200'
                      }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag }}
                    {%- endif -%}
                  </div>
                  <h3 class="dropdown-title">{{ block.settings.title | escape }}</h3>
                </a>
              {%- endfor -%}
            </div>
          </div>
        </div>
        <a href="{{ contact_url }}" class="{% if request.path == contact_url %}active{% endif %}">
          {{ section.settings.contact_label | escape }}
        </a>
      </div>
    </div>

    {%- comment -%} Logo {%- endcomment -%}
    <div class="logo logo-desktop">
      <a href="{{ routes.root_url }}" class="header__heading-link">
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
          {%- assign logo_height = settings.logo_width | default: 150 | divided_by: settings.logo.aspect_ratio -%}
          {{
            settings.logo
            | image_url: width: 300
            | image_tag:
              class: 'motion-reduce',
              alt: logo_alt,
              height: logo_height,
              loading: 'eager',
              widths: '100, 150, 200, 250, 300'
          }}
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <div class="logo logo-mobile">
      <a href="{{ routes.root_url }}">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 200 | image_tag: alt: shop.name }}
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    {%- comment -%} Desktop right nav + header actions {%- endcomment -%}
    <div class="nav right-nav desktop-nav">
      <div class="nav-links">
        <a href="{{ shop_url }}" class="{% if request.path == shop_url %}active{% endif %}">
          {{ section.settings.shop_label | escape }}
        </a>
      </div>
      <div class="header-actions">
        {%- if search_style == 'modal' -%}
          {% render 'search', style: search_style, display_style: 'icon' %}
        {%- else -%}
          <a href="{{ routes.search_url }}" class="link" aria-label="{{ 'content.search_input_label' | t }}">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
          </a>
        {%- endif -%}

        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="user-icon link"
            aria-label="{%- if customer -%}{{ 'accessibility.account' | t }}{%- else -%}{{ 'actions.log_in' | t }}{%- endif -%}"
          >
            <i class="fa-solid fa-user"></i>
          </a>
        {%- endif -%}

        <a href="{{ routes.cart_url }}" class="bag-icon link" id="cart-icon-bubble" aria-label="{{ 'accessibility.cart' | t }}">
          <i class="fa-solid fa-bag-shopping"></i>
          {%- if cart != empty -%}
            <span class="cart-count-bubble" aria-hidden="true">
              {%- if cart.item_count < 100 -%}{{ cart.item_count }}{%- endif -%}
            </span>
          {%- endif -%}
        </a>

        {% comment %} <a href="{{ shop_url }}" class="cta nav-shop-button">{{ section.settings.shop_label | escape }}</a> {% endcomment %}
      </div>
    </div>

    {%- comment -%} Mobile header actions {%- endcomment -%}
    <div class="header-actions header-actions-mobile">
      {%- if search_style == 'modal' -%}
        {% render 'search', style: search_style, display_style: 'icon' %}
      {%- else -%}
        <a href="{{ routes.search_url }}" class="link" aria-label="{{ 'content.search_input_label' | t }}">
          <i class="fa-solid fa-magnifying-glass search-icon"></i>
        </a>
      {%- endif -%}
      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="user-icon link">
          <i class="fa-solid fa-user"></i>
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="bag-icon link">
        <i class="fa-solid fa-bag-shopping"></i>
        {%- if cart != empty -%}
          <span class="cart-count-bubble" aria-hidden="true">{%- if cart.item_count < 100 -%}{{ cart.item_count }}{%- endif -%}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  {%- comment -%} Mobile menu overlay - required by global.js {%- endcomment -%}
  <div class="mobile-menu-overlay" id="mobile-menu">
    <div class="mobile-menu-content">
      <div class="mobile-menu-header">
        <a href="{{ routes.root_url }}" class="mobile-menu-logo">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 150 | image_tag: alt: shop.name }}
          {%- else -%}
            <span>{{ shop.name }}</span>
          {%- endif -%}
        </a>
        <button class="mobile-menu-close" aria-label="{{ 'accessibility.close_dialog' | t }}">
          <i class="fa-solid fa-times"></i>
        </button>
      </div>
      <nav class="mobile-nav-links" aria-label="{{ 'accessibility.header_navigation_label' | t }}">
        <a href="{{ home_url }}" class="mobile-nav-link{% if request.path == home_url %} active{% endif %}">
          {{ section.settings.home_label | escape }}
        </a>

        <div class="mobile-nav-dropdown">
          <a href="{{ explore_url }}" class="mobile-nav-link mobile-dropdown-trigger">
            {{ section.settings.explore_label | escape }}
            <i class="fa-solid fa-chevron-down"></i>
          </a>
          <div class="mobile-dropdown-menu">
            {%- for block in section.blocks -%}
              <a href="{{ block.settings.url }}" class="mobile-dropdown-link" {{ block.shopify_attributes }}>
                {{ block.settings.title | escape }}
              </a>
            {%- endfor -%}
          </div>
        </div>

        <a href="{{ contact_url }}" class="mobile-nav-link{% if request.path == contact_url %} active{% endif %}">
          {{ section.settings.contact_label | escape }}
        </a>
        <a href="{{ shop_url }}" class="mobile-nav-link{% if request.path == shop_url %} active{% endif %}">
          {{ section.settings.shop_label | escape }}
        </a>
      </nav>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "t:names.header",
  "tag": "header",
  "class": "header-section",
  "settings": [
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "home_url",
      "label": "Home URL",
      "default": "/"
    },
    {
      "type": "text",
      "id": "explore_label",
      "label": "Explore label",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "explore_url",
      "label": "Explore URL",
      "default": "/pages/about"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact label",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "contact_url",
      "label": "Contact URL",
      "default": "/pages/contact"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop label",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "shop_url",
      "label": "Shop URL",
      "default": "/collections/all"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:settings.search_icon",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "explore_item",
      "name": "Explore item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Our Story"
        },
        {
          "type": "text",
          "id": "url",
          "label": "URL (supports #anchors)",
          "default": "/pages/about#our-story"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        }
      ]
    }
  ],
  "presets": []
}
{% endschema %}
