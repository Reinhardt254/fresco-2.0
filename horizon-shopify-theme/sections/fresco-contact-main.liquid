<section class="contact-main" {{ section.shopify_attributes }}>
  <div class="contact-main-container">
    <div class="contact-main-left">
      <div class="contact-cards-grid">
        <div class="contact-card">
          <div class="contact-card-icon"><i class="{{ section.settings.card1_icon }}" aria-hidden="true"></i></div>
          <h3 class="contact-card-label">{{ section.settings.card1_label }}</h3>
          <p class="contact-card-detail"><a href="{{ section.settings.card1_link }}">{{ section.settings.card1_text }}</a></p>
        </div>
        <div class="contact-card">
          <div class="contact-card-icon"><i class="{{ section.settings.card2_icon }}" aria-hidden="true"></i></div>
          <h3 class="contact-card-label">{{ section.settings.card2_label }}</h3>
          <p class="contact-card-detail"><a href="{{ section.settings.card2_link }}">{{ section.settings.card2_text }}</a></p>
        </div>
        <div class="contact-card">
          <div class="contact-card-icon"><i class="{{ section.settings.card3_icon }}" aria-hidden="true"></i></div>
          <h3 class="contact-card-label">{{ section.settings.card3_label }}</h3>
          <p class="contact-card-detail"><a href="{{ section.settings.card3_link }}">{{ section.settings.card3_text }}</a></p>
        </div>
        <div class="contact-card">
          <div class="contact-card-icon"><i class="{{ section.settings.card4_icon }}" aria-hidden="true"></i></div>
          <h3 class="contact-card-label">{{ section.settings.card4_label }}</h3>
          <p class="contact-card-detail">{{ section.settings.card4_text }}</p>
        </div>
      </div>
      <div class="contact-map-wrap">
        <iframe
          src="{{ section.settings.map_embed_url }}"
          width="100%"
          height="100%"
          style="border: 0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Location map"
        ></iframe>
      </div>
    </div>

    <div class="contact-main-right">
      <h2 class="contact-form-heading">{{ section.settings.form_heading }}</h2>
      <p class="contact-form-desc">{{ section.settings.form_description }}</p>

      {% form 'contact', class: 'contact-form-fields', aria-label: 'Contact form' %}
        {% if form.posted_successfully? %}
          <p class="contact-form-success">Thanks! We received your message.</p>
        {% endif %}
        {{ form.errors | default_errors }}

        <div class="contact-field">
          <label for="contact-name">Name</label>
          <input type="text" id="contact-name" name="contact[name]" placeholder="Your name" required class="contact-form-input" value="{{ form.name }}">
        </div>
        <div class="contact-field">
          <label for="contact-email">Email</label>
          <input type="email" id="contact-email" name="contact[email]" placeholder="example@yourmail.com" required class="contact-form-input" value="{{ form.email }}">
        </div>
        <div class="contact-field">
          <label for="contact-subject">Subject</label>
          <input type="text" id="contact-subject" name="contact[subject]" placeholder="Title..." class="contact-form-input">
        </div>
        <div class="contact-field">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="contact[body]" placeholder="Type here..." rows="5" class="contact-form-textarea">{{ form.body }}</textarea>
        </div>
        <button type="submit" class="contact-form-submit">{{ section.settings.submit_label }}</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fresco Contact Main",
  "tag": "section",
  "class": "section-fresco-contact-main",
  "settings": [
    { "type": "text", "id": "card1_icon", "label": "Card 1 icon class", "default": "fa-solid fa-phone" },
    { "type": "text", "id": "card1_label", "label": "Card 1 label", "default": "Phone" },
    { "type": "text", "id": "card1_text", "label": "Card 1 text", "default": "+1 (901) 896-5814" },
    { "type": "text", "id": "card1_link", "label": "Card 1 link", "default": "tel:+19018965814" },
    { "type": "text", "id": "card2_icon", "label": "Card 2 icon class", "default": "fa-brands fa-whatsapp" },
    { "type": "text", "id": "card2_label", "label": "Card 2 label", "default": "Whatsapp" },
    { "type": "text", "id": "card2_text", "label": "Card 2 text", "default": "+1 (901) 896-5814" },
    { "type": "text", "id": "card2_link", "label": "Card 2 link", "default": "https://wa.me/19018965814" },
    { "type": "text", "id": "card3_icon", "label": "Card 3 icon class", "default": "fa-solid fa-envelope" },
    { "type": "text", "id": "card3_label", "label": "Card 3 label", "default": "Email" },
    { "type": "text", "id": "card3_text", "label": "Card 3 text", "default": "info@frescoflavors.com" },
    { "type": "text", "id": "card3_link", "label": "Card 3 link", "default": "mailto:info@frescoflavors.com" },
    { "type": "text", "id": "card4_icon", "label": "Card 4 icon class", "default": "fa-solid fa-shop" },
    { "type": "text", "id": "card4_label", "label": "Card 4 label", "default": "Our Shop" },
    { "type": "text", "id": "card4_text", "label": "Card 4 text", "default": "7910 Moriarty Rd, Cordova, TN 38018" },
    { "type": "textarea", "id": "map_embed_url", "label": "Google Maps embed URL", "default": "https://www.google.com/maps/embed?pb=!1m10!1m8!1m3!1d61881.489831128325!2d-89.83236344471175!3d35.19412175135412!3m2!1i1024!2i768!4f13.1!5e1!3m2!1sen!2ske!4v1764248724074!5m2!1sen!2ske" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Get In Touch" },
    { "type": "textarea", "id": "form_description", "label": "Form description", "default": "We're here to help you with any questions or concerns. Send us a message and we'll get back to you as soon as we can." },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Send Now" }
  ],
  "presets": [{ "name": "Fresco Contact Main" }]
}
{% endschema %}
