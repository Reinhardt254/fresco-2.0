<section class="contact-page-layout" {{ section.shopify_attributes }}>
  <img
    src="{% if section.settings.background_image != blank %}{{ section.settings.background_image | image_url: width: 2200 }}{% else %}{{ section.settings.background_image_url_fallback }}{% endif %}"
    alt=""
    width="2200"
    height="1000"
  >
  <div class="layout-content">
    <h1>{{ section.settings.heading_prefix }} <span class="highlight">{{ section.settings.heading_highlight }}</span></h1>
    {% comment %} <p>
      {{ section.settings.subheading }}
    </p> {% endcomment %}
  </div>

  <div class="hero-overlay-global">
    <div class="overlay-items">
      {%- if section.settings.overlay_top_left != blank -%}
        <div class="top-left-overlay overlay-item">
          <img
            src="{{ section.settings.overlay_top_left | image_url: width: 400 }}"
            alt=""
            width="200"
            height="200"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      {%- if section.settings.overlay_top_right != blank -%}
        <div class="top-right-overlay overlay-item">
          <img
            src="{{ section.settings.overlay_top_right | image_url: width: 400 }}"
            alt=""
            width="200"
            height="200"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      {%- if section.settings.overlay_bottom_left != blank -%}
        <div class="bottom-left-overlay overlay-item">
          <img
            src="{{ section.settings.overlay_bottom_left | image_url: width: 400 }}"
            alt=""
            width="200"
            height="200"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      {%- if section.settings.overlay_bottom_right != blank -%}
        <div class="bottom-right-overlay overlay-item">
          <img
            src="{{ section.settings.overlay_bottom_right | image_url: width: 400 }}"
            alt=""
            width="200"
            height="200"
            loading="lazy"
          >
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fresco Contact Hero",
  "tag": "section",
  "class": "section-fresco-contact-hero",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "text", "id": "background_image_url_fallback", "label": "Background image URL fallback", "default": "https://newvashaepz.com/wp-content/uploads/2026/03/0A0A4367.jpg" },
    { "type": "text", "id": "heading_prefix", "label": "Heading prefix", "default": "Contact" },
    { "type": "text", "id": "heading_highlight", "label": "Heading highlight", "default": "Us" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "We're here to help you with any questions or concerns you may have." },
    { "type": "image_picker", "id": "overlay_top_left", "label": "Top left overlay image" },
    { "type": "image_picker", "id": "overlay_top_right", "label": "Top right overlay image" },
    { "type": "image_picker", "id": "overlay_bottom_left", "label": "Bottom left overlay image" },
    { "type": "image_picker", "id": "overlay_bottom_right", "label": "Bottom right overlay image" }
  ],
  "presets": [{ "name": "Fresco Contact Hero" }]
}
{% endschema %}
