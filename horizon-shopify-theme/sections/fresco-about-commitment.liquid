<section class="our-commitment" id="our-commitment" {{ section.shopify_attributes }}>
  <div class="our-commitment-inner">
    <div class="our-commitment-content">
      <h2 class="our-commitment-heading">{{ section.settings.heading }}</h2>

      <ol class="our-commitment-list">
        {% for block in section.blocks %}
          {% if block.type == 'commitment_item' %}
            <li class="commitment-item" {{ block.shopify_attributes }}>
              <div class="commitment-item-header">
                <span class="commitment-item-number">{{ block.settings.item_number }}</span>
                <h3 class="commitment-item-title">
                  {{ block.settings.item_title }}
                </h3>
              </div>
              <p class="commitment-item-text">
                {{ block.settings.item_text }}
              </p>
            </li>
          {% endif %}
        {% endfor %}
      </ol>
    </div>

    <div class="our-commitment-media">
      <div class="our-commitment-media-shape">
        <img
          src="{% if section.settings.side_image != blank %}{{ section.settings.side_image | image_url: width: 1200 }}{% else %}{{ section.settings.side_image_url_fallback }}{% endif %}"
          alt="{{ section.settings.side_image_alt | escape }}"
          width="1200"
          height="900"
        >
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fresco About Commitment",
  "tag": "section",
  "class": "section-fresco-about-commitment",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What We Stand For"
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Side image"
    },
    {
      "type": "text",
      "id": "side_image_url_fallback",
      "label": "Side image URL fallback",
      "default": "https://newvashaepz.com/wp-content/uploads/2026/03/0A0A4464.jpg"
    },
    {
      "type": "text",
      "id": "side_image_alt",
      "label": "Side image alt text",
      "default": "Team preparing fresh ingredients"
    }
  ],
  "blocks": [
    {
      "type": "commitment_item",
      "name": "Commitment item",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "item_number",
          "label": "Item number",
          "default": "-01"
        },
        {
          "type": "text",
          "id": "item_title",
          "label": "Item title",
          "default": "Quality & Natural Integrity"
        },
        {
          "type": "textarea",
          "id": "item_text",
          "label": "Item text",
          "default": "Our herbs are organically grown and freeze-dried to preserve natural qualities without artificial additives, delivering pure flavor and consistent quality."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresco About Commitment",
      "blocks": [
        {
          "type": "commitment_item",
          "settings": {
            "item_number": "-01",
            "item_title": "Quality & Natural Integrity",
            "item_text": "Our herbs are organically grown and freeze-dried to preserve natural qualities without artificial additives, delivering pure flavor and consistent quality."
          }
        },
        {
          "type": "commitment_item",
          "settings": {
            "item_number": "-02",
            "item_title": "Commitment to Transparency",
            "item_text": "We believe customers should know what goes into their food. That's why we provide clear sourcing and production information, ensuring confidence."
          }
        },
        {
          "type": "commitment_item",
          "settings": {
            "item_number": "-03",
            "item_title": "Social & Environmental Impact",
            "item_text": "We support sustainable agriculture and responsible production while creating employment opportunities for local communities across Kenya, from farms to processing facilities."
          }
        }
      ],
      "settings": {
        "heading": "What We Stand For",
        "side_image_url_fallback": "https://newvashaepz.com/wp-content/uploads/2026/03/0A0A4464.jpg",
        "side_image_alt": "Team preparing fresh ingredients"
      }
    }
  ]
}
{% endschema %}
