<section class="food-recipes" id="recipes" {{ section.shopify_attributes }}>
  <div class="food-recipes-container">
    <div class="food-recipes-text">
      <p class="food-recipes-kicker">{{ section.settings.kicker }}</p>
      <h2 class="food-recipes-heading">
        {{ section.settings.heading }}
      </h2>
      <div class="food-recipes-separator"></div>
      <p class="food-recipes-copy">
        {{ section.settings.copy }}
      </p>

      <div class="food-recipes-stats">
        {% for block in section.blocks %}
          {% if block.type == 'stat_card' %}
            <div class="food-recipes-stat-card" {{ block.shopify_attributes }}>
              <span class="food-recipes-stat-icon"><i class="{{ block.settings.icon_class }}"></i></span>
              <span class="food-recipes-stat-value">{{ block.settings.value }}</span>
              <span class="food-recipes-stat-label">{{ block.settings.label }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="food-recipes-gallery">
      <div class="food-recipes-badge">
        <img
          src="{% if section.settings.badge_image != blank %}{{ section.settings.badge_image | image_url: width: 180 }}{% else %}{{ section.settings.badge_image_url_fallback }}{% endif %}"
          alt="{{ section.settings.badge_image_alt | escape }}"
          width="100"
          height="100"
        >
      </div>
      <div class="food-recipes-grid">
        <div class="column">
          <div class="food-recipes-image large-image">
            <img
              src="{% if section.settings.col1_large_image != blank %}{{ section.settings.col1_large_image | image_url: width: 1200 }}{% else %}{{ section.settings.col1_large_image_url_fallback }}{% endif %}"
              alt="{{ section.settings.col1_large_image_alt | escape }}"
              width="1200"
              height="900"
            >
          </div>
          <div class="food-recipes-image small-image">
            <img
              src="{% if section.settings.col1_small_image != blank %}{{ section.settings.col1_small_image | image_url: width: 900 }}{% else %}{{ section.settings.col1_small_image_url_fallback }}{% endif %}"
              alt="{{ section.settings.col1_small_image_alt | escape }}"
              width="900"
              height="700"
            >
          </div>
        </div>
        <div class="column">
          <div class="food-recipes-image small-image">
            <img
              src="{% if section.settings.col2_small_image != blank %}{{ section.settings.col2_small_image | image_url: width: 900 }}{% else %}{{ section.settings.col2_small_image_url_fallback }}{% endif %}"
              alt="{{ section.settings.col2_small_image_alt | escape }}"
              width="900"
              height="700"
            >
          </div>
          <div class="food-recipes-image large-image">
            <img
              src="{% if section.settings.col2_large_image != blank %}{{ section.settings.col2_large_image | image_url: width: 1200 }}{% else %}{{ section.settings.col2_large_image_url_fallback }}{% endif %}"
              alt="{{ section.settings.col2_large_image_alt | escape }}"
              width="1200"
              height="900"
            >
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="food-recipes-button-container">
    <a href="{{ section.settings.button_link }}" class="cta-btn">{{ section.settings.button_label }}</a>
  </div>
</section>

{% schema %}
{
