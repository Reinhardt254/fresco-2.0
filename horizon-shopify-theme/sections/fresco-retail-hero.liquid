<section class="retail-hero" {{ section.shopify_attributes }}>
    {%- comment -%} Decorative overlay images (corners) {%- endcomment -%}
  <div class="hero-overlay-global">
      <div class="overlay-items">
        {%- if section.settings.overlay_top_left != blank -%}
          <div class="top-left-overlay overlay-item">
            <img
              src="{{ section.settings.overlay_top_left | image_url: width: 300 }}"
              alt=""
              width="150"
              height="150"
              loading="lazy"
            >
          </div>
        {%- endif -%}
        {%- if section.settings.overlay_top_right != blank -%}
          <div class="top-right-overlay overlay-item">
            <img
              src="{{ section.settings.overlay_top_right | image_url: width: 300 }}"
              alt=""
              width="150"
              height="150"
              loading="lazy"
            >
          </div>
        {%- endif -%}
        {%- if section.settings.overlay_bottom_left != blank -%}
          <div class="bottom-left-overlay overlay-item">
            <img
              src="{{ section.settings.overlay_bottom_left | image_url: width: 300 }}"
              alt=""
              width="150"
              height="150"
              loading="lazy"
            >
          </div>
        {%- endif -%}
        {%- if section.settings.overlay_bottom_right != blank -%}
          <div class="bottom-right-overlay overlay-item leaf">
            <img
              src="{{ section.settings.overlay_bottom_right | image_url: width: 400 }}"
              alt=""
              width="250"
              height="300"
              loading="lazy"
            >
          </div>
        {%- endif -%}
      </div>
    </div>
  <div class="retail-hero-bg">
    <img
      src="{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2200 }}{% else %}{{ section.settings.hero_image_url_fallback }}{% endif %}"
      alt=""
      width="2200"
      height="1100"
    >
  </div>
  <div class="retail-hero-overlay"></div>
  <div class="retail-hero-content">
    {%- assign title_segments = section.blocks | where: 'type', 'title_segment' -%}
    <h1 class="retail-hero-title">
      {%- if title_segments.size > 0 -%}
        {%- for block in title_segments -%}
          {%- if block.settings.text != blank -%}
            {%- if block.settings.highlight -%}
              <span class="highlight">{{ block.settings.text }}</span>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {{ section.settings.title_prefix }}
        <span class="highlight">{{ section.settings.title_highlight }}</span>
        {{ section.settings.title_suffix }}
      {%- endif -%}
    </h1>
    <p class="retail-hero-tagline">
      {{ section.settings.tagline }}
    </p>
    <a href="{{ section.settings.button_link }}" class="contact-us-btn">{{ section.settings.button_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Fresco Retail Hero",
  "tag": "section",
  "class": "section-fresco-retail-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "overlay_top_left",
      "label": "Top left overlay"
    },
    {
      "type": "image_picker",
      "id": "overlay_top_right",
      "label": "Top right overlay"
    },
    {
      "type": "image_picker",
      "id": "overlay_bottom_left",
      "label": "Bottom left overlay"
    },
    {
      "type": "image_picker",
      "id": "overlay_bottom_right",
      "label": "Bottom right overlay (leaf)"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image"
    },
    {
      "type": "text",
      "id": "hero_image_url_fallback",
      "label": "Hero background image URL fallback",
      "default": "https://newvashaepz.com/wp-content/uploads/2026/03/african-young-couple-with-shopping-trolley-shoppin-2026-01-07-00-04-03-utc-scaled.jpg"
    },
    {
      "type": "text",
      "id": "title_prefix",
      "label": "Title prefix",
      "default": "Vertically Integrated",
      "info": "Fallback heading: used only when no Heading segment blocks are added."
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Highlighted title text",
      "default": "Organic Herbs",
      "info": "Fallback heading: used only when no Heading segment blocks are added."
    },
    {
      "type": "text",
      "id": "title_suffix",
      "label": "Title suffix",
      "default": "You Can Rely On.",
      "info": "Fallback heading: used only when no Heading segment blocks are added."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Premium organic herbs for US supermarkets"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "title_segment",
      "name": "Heading segment",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your supply remains as"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight (green)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresco Retail Hero",
      "blocks": [
        {
          "type": "title_segment",
          "settings": { "text": "Your supply remains as", "highlight": false }
        },
        {
          "type": "title_segment",
          "settings": { "text": "stable ", "highlight": true }
        },
        {
          "type": "title_segment",
          "settings": { "text": "as it is", "highlight": false }
        },
        {
          "type": "title_segment",
          "settings": { "text": " scalable. ", "highlight": true }
        }
      ],
      "settings": {
        "hero_image_url_fallback": "https://newvashaepz.com/wp-content/uploads/2026/03/african-young-couple-with-shopping-trolley-shoppin-2026-01-07-00-04-03-utc-scaled.jpg",
        "title_prefix": "Vertically Integrated",
        "title_highlight": "Organic Herbs",
        "title_suffix": "You Can Rely On.",
        "tagline": "Premium organic herbs for US supermarkets",
        "button_label": "Contact Us",
        "button_link": "shopify://pages/contact"
      }
    }
  ]
}
{% endschema %}
