{%- comment -%}
  Fresco-style footer. Uses site-footer, footer-main, footer-columns, footer-bottom,
  footer-scroll-top structure expected by assets/fresco/styles/global.css and
  assets/fresco/scripts/global.js.
{%- endcomment -%}

<footer class="site-footer">
  {%- if section.settings.enable_newsletter -%}
    <div class="footer-newsletter">
      <div class="footer-container footer-newsletter-inner">
        <div class="footer-newsletter-text">
          <h2 class="footer-newsletter-heading">{{ section.settings.newsletter_heading | default: 'Subscribe Newsletter' }}</h2>
          <p class="footer-newsletter-desc">{{ section.settings.newsletter_desc | default: 'Get e-mail updates about our latest shop and special offers.' }}</p>
        </div>
        {% form 'customer', class: 'footer-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            class="footer-newsletter-input"
            value="{{ form.email }}"
            placeholder="Your email"
            aria-label="Email"
            required
          >
          <button type="submit" class="footer-newsletter-btn">Subscribe</button>
        {% endform %}
      </div>
    </div>
    <div class="footer-newsletter-divider"></div>
  {%- endif -%}

  <div class="footer-main">
    <div class="footer-container footer-columns">
      {%- for block in section.blocks -%}
        {%- if block.type == 'payment_icon' -%}
          {%- continue -%}
        {%- endif -%}
        {%- if block.type == 'instagram_image' -%}
          {%- continue -%}
        {%- endif -%}
        {%- case block.type -%}
          {%- when 'logo_text' -%}
            <div class="footer-col footer-col-company" {{ block.shopify_attributes }}>
              <div class="footer-logo">
                {%- if block.settings.logo_image != blank -%}
                  <a href="{{ routes.root_url }}">
                    <img
                      src="{{ block.settings.logo_image | image_url: width: 200 }}"
                      alt="{{ block.settings.logo_image.alt | default: shop.name | escape }}"
                      width="180"
                      height="auto"
                      loading="lazy"
                    >
                  </a>
                {%- elsif settings.logo != blank -%}
                  <a href="{{ routes.root_url }}">
                    {{ settings.logo | image_url: width: 200 | image_tag: alt: shop.name, loading: 'lazy' }}
                  </a>
                {%- else -%}
                  <a href="{{ routes.root_url }}" class="footer-logo-text">{{ shop.name }}</a>
                {%- endif -%}
              </div>
              {%- if block.settings.tagline_text != blank -%}
                <p class="footer-tagline">{{ block.settings.tagline_text }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="footer-company-desc">{{ block.settings.description }}</p>
              {%- endif -%}
              {%- if block.settings.show_contact_in_column -%}
                <ul class="footer-contact">
                  {%- if block.settings.phone != blank -%}
                    <li><i class="fa-solid fa-phone"></i><a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a></li>
                  {%- endif -%}
                  {%- if block.settings.email != blank -%}
                    <li><i class="fa-solid fa-envelope"></i><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
                  {%- endif -%}
                  {%- if block.settings.address != blank -%}
                    <li><i class="fa-solid fa-location-dot"></i><span>{{ block.settings.address }}</span></li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
            </div>

          {%- when 'quick_links' -%}
            <div class="footer-col footer-col-links" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="footer-col-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer-links">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

          {%- when 'contact_info' -%}
            <div class="footer-col footer-col-links" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="footer-col-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              <ul class="footer-contact">
                {%- if block.settings.address != blank -%}
                  <li><i class="fa-solid fa-location-dot"></i><span class="rte">{{ block.settings.address }}</span></li>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  <li><i class="fa-solid fa-phone"></i><a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a></li>
                {%- endif -%}
                {%- if block.settings.email != blank -%}
                  <li><i class="fa-solid fa-envelope"></i><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
                {%- endif -%}
              </ul>
            </div>

          {%- when 'social_links' -%}
            <div class="footer-col footer-col-instagram" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="footer-col-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              <div class="footer-instagram-grid" aria-label="Social links">
                {%- if settings.social_instagram_link != blank -%}
                  <a href="{{ settings.social_instagram_link }}" class="footer-instagram-item" target="_blank" rel="noopener" aria-label="Instagram">
                    <i class="fa-brands fa-instagram" style="font-size: 24px; color: #555;"></i>
                  </a>
                {%- endif -%}
                {%- if settings.social_facebook_link != blank -%}
                  <a href="{{ settings.social_facebook_link }}" class="footer-instagram-item" target="_blank" rel="noopener" aria-label="Facebook">
                    <i class="fa-brands fa-facebook" style="font-size: 24px; color: #555;"></i>
                  </a>
                {%- endif -%}
                {%- if settings.social_pinterest_link != blank -%}
                  <a href="{{ settings.social_pinterest_link }}" class="footer-instagram-item" target="_blank" rel="noopener" aria-label="Pinterest">
                    <i class="fa-brands fa-pinterest" style="font-size: 24px; color: #555;"></i>
                  </a>
                {%- endif -%}
              </div>
            </div>

          {%- when 'instagram_grid' -%}
            {%- assign instagram_image_blocks = section.blocks | where: 'type', 'instagram_image' -%}
            {%- assign has_instagram_images = false -%}
            {%- for img_block in instagram_image_blocks -%}
              {%- if img_block.settings.image != blank -%}
                {%- assign has_instagram_images = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if has_instagram_images -%}
              <div class="footer-col footer-col-instagram-grid" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h3 class="footer-col-heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                <div class="footer-instagram-grid footer-instagram-grid-images" aria-label="Instagram gallery">
                  {%- for img_block in instagram_image_blocks -%}
                    {%- if img_block.settings.image != blank -%}
                      {%- if img_block.settings.link != blank -%}
                        <a href="{{ img_block.settings.link }}" class="footer-instagram-item" target="_blank" rel="noopener" {{ img_block.shopify_attributes }}>
                          <img
                            src="{{ img_block.settings.image | image_url: width: 200 }}"
                            alt="{{ img_block.settings.image.alt | default: 'Instagram' | escape }}"
                            width="100"
                            height="100"
                            loading="lazy"
                          >
                        </a>
                      {%- else -%}
                        <span class="footer-instagram-item" {{ img_block.shopify_attributes }}>
                          <img
                            src="{{ img_block.settings.image | image_url: width: 200 }}"
                            alt="{{ img_block.settings.image.alt | default: 'Instagram' | escape }}"
                            width="100"
                            height="100"
                            loading="lazy"
                          >
                        </span>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-container footer-bottom-inner">
      <p class="footer-copyright">&copy; {{ 'now' | date: '%Y' }}, {{ shop.name }}.</p>
      {%- if section.settings.show_policy and shop.policies.size > 0 -%}
        <div class="footer-policy-links">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
              {%- unless forloop.last -%}<span aria-hidden="true"> · </span>{%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- assign payment_icon_blocks = section.blocks | where: 'type', 'payment_icon' -%}
      {%- assign has_custom_payment_icons = false -%}
      {%- for block in payment_icon_blocks -%}
        {%- if block.settings.image != blank -%}
          {%- assign has_custom_payment_icons = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if has_custom_payment_icons -%}
        <div class="footer-payments footer-payments-gallery" aria-label="Payment methods">
          {%- for block in payment_icon_blocks -%}
            {%- if block.settings.image != blank -%}
              <span class="footer-payment-icon" {{ block.shopify_attributes }}>
                <img
                  src="{{ block.settings.image | image_url: width: 80 }}"
                  alt="{{ block.settings.image.alt | default: 'Payment method' | escape }}"
                  width="50"
                  height="40"
                  loading="lazy"
                >
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- elsif section.settings.show_payment_icons and shop.enabled_payment_types != empty -%}
        <div class="footer-payments" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <button type="button" class="footer-scroll-top" aria-label="{{ 'accessibility.scroll_to' | t: title: 'top' }}">
      <i class="fa-solid fa-arrow-up"></i>
    </button>
  </div>
</footer>

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "logo_text",
      "name": "Logo and text",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo image"
        },
        {
          "type": "textarea",
          "id": "tagline_text",
          "label": "Tagline",
          "default": "Bringing the best herbs in every jar. 100% Organic."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "checkbox",
          "id": "show_contact_in_column",
          "label": "Show contact in this column",
          "default": false
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address"
        }
      ]
    },
    {
      "type": "quick_links",
      "name": "Quick links",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "contact_info",
      "name": "Contact info",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact"
        },
        {
          "type": "richtext",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        }
      ]
    },
    {
      "type": "social_links",
      "name": "Social links",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Follow us"
        }
      ]
    },
    {
      "type": "payment_icon",
      "name": "t:names.payment_icon",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:content.image",
          "info": "Upload payment method icon (e.g. Visa, Mastercard, PayPal)"
        }
      ]
    },
    {
      "type": "instagram_grid",
      "name": "t:names.instagram_grid",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:content.heading",
          "default": "Instagram"
        }
      ]
    },
    {
      "type": "instagram_image",
      "name": "t:names.instagram_image",
      "limit": 9,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:content.image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:content.link",
          "info": "Optional link (e.g. Instagram post or product)"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "enable_newsletter",
      "label": "Enable newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Subscribe Newsletter"
    },
    {
      "type": "textarea",
      "id": "newsletter_desc",
      "label": "Description",
      "default": "Get e-mail updates about our latest shop and special offers."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Add 'Payment icon' blocks below to upload custom payment method images. If no custom icons are added, Shopify payment types will show when enabled."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show default payment icons",
      "default": true,
      "info": "Shows Shopify payment types when no custom Payment icon blocks are added"
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "logo_text",
        "settings": {
          "tagline_text": "Bringing the best herbs in every jar. 100% Organic."
        }
      },
      {
        "type": "quick_links",
        "settings": {
          "heading": "Quick Links",
          "menu": "footer"
        }
      },
      {
        "type": "contact_info",
        "settings": {
          "heading": "Contact"
        }
      }
    ]
  }
}
{% endschema %}
